{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zsetup-tools",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "r2_buckets": [
    {
      "bucket_name": "zsetup-public",
      "binding": "BUCKET_PUBLIC",
    },
    {
      "bucket_name": "zsetup-private",
      "binding": "BUCKET_PRIVATE",
    },
  ],
}
